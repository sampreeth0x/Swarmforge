# ── SwarmForge configuration ─────────────────────────────────────────────
# Copy to .env and fill in. Everything works with ZERO keys in mock mode.

# mock | tokenfactory | nim
SWARMFORGE_MODE=mock

# ── Nebius Token Factory (https://docs.tokenfactory.nebius.com) ──────────
# API key from console.nebius.com → Token Factory
SWARMFORGE_LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_TOKEN_FACTORY_API_KEY=

# Nemotron model IDs (verify with `swarmforge list-models`)
SWARMFORGE_MODEL_PLANNER=nemotron-3-super-120b-a12b
SWARMFORGE_MODEL_WORKER=nemotron-3-nano-30b-a3b

# ── NVIDIA NIM fallback (https://build.nvidia.com) ───────────────────────
NVIDIA_NIM_API_KEY=
SWARMFORGE_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# ── Nebius Sandboxes / Contree (cloud sandbox mode) ──────────────────────
# IAM bearer token + project id; used with `pip install swarmforge[cloud]`
NEBIUS_IAM_TOKEN=
NEBIUS_PROJECT_ID=
SWARMFORGE_SANDBOX_BACKEND=local   # local | contree

# ── Swarm sizing ─────────────────────────────────────────────────────────
SWARMFORGE_WORKERS=4               # 2-8 worker agents per mission
SWARMFORGE_AGENT_MAX_STEPS=24